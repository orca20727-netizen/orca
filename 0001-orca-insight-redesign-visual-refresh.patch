-/*!
- * transparent-cards.css (v2)
- * Goal: no solid/boxed panels anywhere in the app -- every card becomes
- * pure text floating over the ambient background, outlined only by
- * the animated neon border (neon-border.js).
- *
- * LOAD ORDER: link this AFTER styles.css in index.html:
- *   <link rel="stylesheet" href="styles.css">
- *   <link rel="stylesheet" href="transparent-cards.css">
- *
- * WHAT THIS DELIBERATELY LEAVES ALONE (and why):
- * - Buttons (SOS, CTAs, nav tabs, "Ask Agents", filter chips) -- these
- *   are controls, not text cards; killing their fill makes them
- *   invisible / hard to tap.
- * - <select> dropdowns and the search <input> -- same reason.
- * - Vessel table row status coloring (Safe Fishing / Border Alert
- *   etc.) -- that color IS the information, not decoration.
- * - The live map + its HUD overlay bar -- the HUD sits on top of the
- *   map imagery itself, not on the sky background, so making it
- *   transparent would make it unreadable against the map.
- * - The Agent DAG Visualizer's canvas + its 8 node cards -- restored to
- *   real glass boxes below (see that section) after the flatten made the
- *   dense grid of agent cards read as an unreadable wall of text.
- * If you want any of those flattened too, tell me which one and I'll
- * add it -- I kept them solid on purpose rather than guessing wrong.
- */
-
-/* ---- Core repeating surfaces ---- */
-.glass-card,
-.glass-card-strong,
-.glass-header,
-.glass-nav,
-.glass-chip {
-    /* Same treatment as the satellite reference cards below: drop the
-       white fill entirely but keep the base .glass-card rule's own
-       backdrop-filter blur + border (defined in styles.css) so every
-       card reads as frosted/blurred glass over the live ocean image
-       instead of a solid white panel. */
-    background: transparent !important;
-    background-color: transparent !important;
-    box-shadow: none !important;
-}
-
-/* ---- Hero banner + Safety Barometer verdict panel (inline Tailwind
-   backgrounds, not .glass-card) ---- */
-#heroBanner {
-    background: transparent !important;
-    background-image: none !important;
-    box-shadow: none !important;
-}
-
-/* ---- Safety score box inside the verdict card ---- */
-#safetyIndexRing,
-#safetyVerdictCard > div.bg-ocean-950\/90 {
-    background: transparent !important;
-    border-color: rgba(255, 255, 255, 0.15) !important;
-}
-
-/* ---- IMBL border alert card (Fleet Monitor) ---- */
-#imblAlertCard {
-    background: transparent !important;
-}
-
-/* ---- Chat message bubbles ---- */
-#chatMessages .bg-slate-900 {
-    background: transparent !important;
-    border-color: transparent !important;
-}
-
-/* ---- Recording / status banners ---- */
-#sttRecordingStatus,
-#apiLiveBadge,
-#backendStatusBadge,
-#dagBackendStatusBadge {
-    background: transparent !important;
-}
-
-/* ---- Agent DAG Visualizer -- glass boxes restored ----
-   Previously flattened along with everything else below; the DAG canvas
-   and its 8 generated agent-node cards are dense, close together, and
-   read as a jumbled wall of text without a visible box per node, so
-   they're excluded from the flatten and given their real glass fill
-   back. Higher-specificity selectors so they win over the generic
-   .glass-card flatten rule above despite both using !important. */
-#dagNodesGrid > div.glass-card,
-.dag-canvas-container {
-    background: transparent !important;
-    background-color: transparent !important;
-    box-shadow: none !important;
-}
-
-/* ---- Satellite reference cards + Advisory Bulletins (JS-generated
-   direct-child cards) ---- */
-#satelliteCardsGrid > div,
-#bulletinsListContainer > div {
-    background: transparent !important;
-    box-shadow: none !important;
-}
-/* ---- Kill the dark-navy "cyan" text/highlight inside satellite boxes ---- */
-#satelliteCardsGrid > div .text-cyan-300,
-#satelliteCardsGrid > div .text-cyan-400 {
-    color: var(--slate-400) !important; /* or any other color you prefer */
-}
-
-/* ---- Table header strip (Fleet Monitor) ---- */
-table thead tr.bg-ocean-950\/60 {
-    background: transparent !important;
-}
-
-/* ---- Terminal-style panes ---- */
-#nmeaLiveConsole,
-#inspectorRawJSON {
-    background: transparent !important;
-}
