diff --git a/styles.css b/styles.css
index 183f101..754f0f5 100644
--- a/styles.css
+++ b/styles.css
@@ -518,7 +518,71 @@ body {
    Typography (glass restyle, phase 5)
    ============================================ */
 .text-gradient {
+  background: linear-gradient(120deg, var(--cyan-primary) 0%, var(--teal-primary) 55%, #2b547e 100%) !important;
+  -webkit-background-clip: text !important;
+  background-clip: text !important;
+  color: transparent !important;
+}
+
+/* ============================================
+   Landing gate polish (redesign pass)
+   ============================================ */
+.landing-stagger > .reveal:nth-child(1) { animation-delay: 0s; }
+.landing-stagger > .reveal:nth-child(2) { animation-delay: 0.12s; }
+.landing-stagger > .reveal:nth-child(3) { animation-delay: 0.24s; }
+.landing-stagger > .reveal:nth-child(4) { animation-delay: 0.36s; }
+.landing-stagger > .reveal:nth-child(5) { animation-delay: 0.48s; }
+
+.landing-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-family: var(--font-mono);
+  font-size: 0.72rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
   color: var(--cyan-primary);
+  padding: 6px 14px;
+  border-radius: var(--radius-pill);
+  background: var(--glass-bg);
+  border: 1px solid var(--glass-border);
+  backdrop-filter: blur(var(--glass-blur));
+  -webkit-backdrop-filter: blur(var(--glass-blur));
+}
+
+.landing-mark-ring {
+  position: absolute;
+  inset: -10px;
+  border-radius: inherit;
+  border: 1.5px solid var(--cyan-primary);
+  opacity: 0.35;
+  animation: landingRingPulse 3.2s ease-in-out infinite;
+}
+
+@keyframes landingRingPulse {
+  0%, 100% { transform: scale(1); opacity: 0.35; }
+  50% { transform: scale(1.12); opacity: 0.05; }
+}
+
+.landing-enter-cue {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 2.75rem;
+  font-size: 0.72rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--text-dim);
+  animation: floatSlow 2.6s ease-in-out infinite;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .landing-mark-ring,
+  .landing-enter-cue {
+    animation: none !important;
+  }
 }
 
