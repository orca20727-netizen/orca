# Copy this file to .env and fill in real values. Never commit the real
# .env file -- it's already excluded in .gitignore.

# Optional. If unset, ORCA runs entirely on the deterministic fallback
# engine (still fully functional, just not LLM-generated prose). Get a key
# at https://console.groq.com/keys


GROQ_API_KEY=

# Optional. Which Groq-hosted model to call when GROQ_API_KEY is set.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Seconds to wait for a Groq response before falling back to the
# deterministic engine.
GROQ_TIMEOUT_SEC=8

# Host/port the FastAPI backend binds to. 0.0.0.0 is required (not
# 127.0.0.1/localhost) for phones on the same Wi-Fi to reach it.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed frontend origins for CORS, e.g.
#   FRONTEND_ORIGIN=http://localhost:3000,http://192.168.1.10:3000
# Defaults to "*" (any origin) if unset -- fine for local demo use since
# there are no authenticated endpoints/cookies, but set this explicitly
# for any non-local deployment. Port 3000 matches start_demo.sh/.bat and
# the frontend container's nginx port (see docker-compose.yml) -- update
# this if you serve the static frontend from somewhere else.
FRONTEND_ORIGIN=http://localhost:3000

# Frontend runtime configuration (used by the Railway frontend service).
# Use the public backend URL, including https:// and wss:// respectively.
# Leave these unset for the local two-port Docker/demo setup.
ORCA_API_BASE=
ORCA_WS_BASE=

# Seconds to wait for a live Open-Meteo API response before falling back
# to offline/simulated telemetry.
OPEN_METEO_TIMEOUT=10

# Nautical miles of clearance the A* route planner tries to keep from
# every Marine Protected Area boundary (not just avoiding the polygon
# itself).
MPA_SAFETY_BUFFER_NM=2.0

# Continuous external-data feeds. These run only in the backend, so keys are
# never sent to the browser. Copy the JSON contracts from README.md.
LIVE_FEED_REFRESH_SECONDS=900
EXTERNAL_FEED_TIMEOUT=15
ORCA_OCEAN_FEED_URL=
ORCA_PFZ_FEED_URL=
ORCA_VESSEL_FEED_URL=
EXTERNAL_FEED_BEARER_TOKEN=


# Required only when your GPS/AIS tracker gateway POSTs directly to ORCA at
# /api/telemetry/vessels. Use a long random value; never expose it in the UI.
TELEMETRY_INGEST_TOKEN=
AIS_PUBLISH_INTERVAL_SECONDS=20

# Chat-session context stays in backend memory only and is evicted after this
# many minutes of inactivity. The browser sends at most six recent turns.
SESSION_TTL_MINUTES=30

# Source-registry discovery checks are allowlisted reachability probes only;
# they never scrape restricted data or bypass provider authentication.
SOURCE_REGISTRY_TIMEOUT=5

# Proactive in-app hazard alerts are evaluated on the refresh cycle. They are
# delivered while the browser/PWA is open; closed-app push needs a separate
# push subscription service and is intentionally not claimed by this demo.
HAZARD_WAVE_ALERT_M=2.5
HAZARD_WIND_ALERT_KNOTS=25
HAZARD_LIGHTNING_ALERT_PCT=50

# Browser position tracking stays opt-in. The frontend calls /api/geofence
# for every accepted position and warns at this IMBL approach distance.
GEOFENCE_WARNING_NM=5
